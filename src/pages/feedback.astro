---
import Layout from "../layouts/main.astro";

const title = "Feedback — Querial";
const web3formsAccessKey =
    import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ??
    "0f933f43-72a2-43d6-be0f-5938376ace81";
---

<Layout {title}>
    <section class="py-20 md:py-32">
        <div class="container mx-auto px-4">
            <div class="max-w-3xl mx-auto">
                <div class="text-center space-y-4 mb-12">
                    <h1 class="text-4xl md:text-5xl font-bold">
                        Feed{""}
                        <span
                            class="bg-gradient-to-r from-querial-indigo to-querial-indigo-on-dark bg-clip-text text-transparent"
                        >
                            back
                        </span>
                    </h1>
                    <p class="text-lg text-muted-foreground max-w-xl mx-auto">
                        Questions, bug reports, or ideas for Querial? Send a
                        message and we'll get back to you.
                    </p>
                </div>

                <div
                    class="p-8 md:p-10 rounded-2xl border border-border/50 bg-card/50 backdrop-blur-sm shadow-lg shadow-querial-indigo/5"
                >
                    <h2 class="text-xl font-semibold mb-6">Send a message</h2>

                    <div
                        id="feedback-toast"
                        role="status"
                        aria-live="polite"
                        aria-atomic="true"
                        class="mb-0 flex gap-3 items-start rounded-xl border border-transparent p-0 shadow-sm transition-all duration-300 ease-out opacity-0 max-h-0 overflow-hidden -translate-y-1 pointer-events-none [&.is-open]:mb-6 [&.is-open]:max-h-56 [&.is-open]:translate-y-0 [&.is-open]:overflow-visible [&.is-open]:p-4 [&.is-open]:opacity-100 [&.is-open]:pointer-events-auto [&.is-success]:border-querial-sky/35 [&.is-success]:bg-querial-sky/8 dark:[&.is-success]:bg-querial-sky/12 [&.is-error]:border-destructive/40 [&.is-error]:bg-destructive/6"
                    >
                        <span
                            id="feedback-toast-icon"
                            class="shrink-0 mt-0.5 w-9 h-9 rounded-lg flex items-center justify-center"
                            aria-hidden="true"
                        ></span>
                        <div class="min-w-0 flex-1 pt-0.5">
                            <p
                                id="feedback-toast-title"
                                class="text-sm font-semibold text-foreground"
                            ></p>
                            <p
                                id="feedback-toast-body"
                                class="text-sm text-muted-foreground mt-1"
                            ></p>
                        </div>
                        <button
                            type="button"
                            id="feedback-toast-dismiss"
                            class="shrink-0 rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted/80 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-querial-indigo-on-dark/50"
                            aria-label="Dismiss notification"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M6 18 18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>

                    <form id="form" class="space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label
                                    for="name"
                                    class="block text-sm font-medium mb-2 text-foreground"
                                >
                                    Name
                                </label>
                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-querial-indigo-on-dark/50 focus-visible:ring-offset-2"
                                    placeholder="Your name"
                                    required
                                    autocomplete="name"
                                />
                            </div>
                            <div>
                                <label
                                    for="email"
                                    class="block text-sm font-medium mb-2 text-foreground"
                                >
                                    Email
                                </label>
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-querial-indigo-on-dark/50 focus-visible:ring-offset-2"
                                    placeholder="you@example.com"
                                    required
                                    autocomplete="email"
                                />
                            </div>
                        </div>

                        <div>
                            <label
                                for="subject"
                                class="block text-sm font-medium mb-2 text-foreground"
                            >
                                Subject
                            </label>
                            <input
                                type="text"
                                id="subject"
                                name="subject"
                                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-querial-indigo-on-dark/50 focus-visible:ring-offset-2"
                                placeholder="How can we help?"
                                required
                            />
                        </div>

                        <div>
                            <label
                                for="message"
                                class="block text-sm font-medium mb-2 text-foreground"
                            >
                                Message
                            </label>
                            <textarea
                                id="message"
                                name="message"
                                rows="6"
                                class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-querial-indigo-on-dark/50 focus-visible:ring-offset-2 resize-y min-h-[140px]"
                                placeholder="Your message…"
                                required
                            ></textarea>
                        </div>

                        <div class="space-y-2">
                            <span class="block text-sm font-medium text-foreground">
                                Verification
                            </span>
                            <p class="text-xs text-muted-foreground">
                                Complete the challenge below to send your message.
                            </p>
                            <div
                                id="hcaptcha-widget"
                                class="h-captcha"
                                data-captcha="true"
                                data-size="compact"
                            ></div>
                        </div>

                        <button
                            type="submit"
                            class="inline-flex items-center justify-center gap-2 h-10 px-6 rounded-md bg-gradient-to-r from-querial-indigo to-querial-indigo-on-dark hover:opacity-90 text-white text-sm font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-querial-indigo-on-dark/50 focus-visible:ring-offset-2 w-full md:w-auto disabled:opacity-60 disabled:pointer-events-none"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4 shrink-0"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"
                                ></path>
                            </svg>
                            Send message
                        </button>
                    </form>
                </div>

                <p class="text-center text-sm text-muted-foreground mt-10">
                    Prefer self-serve? Browse the{" "}
                    <a href="/docs" class="text-link hover:underline">documentation</a>
                    {" "}or the{" "}
                    <a href="/labs" class="text-link hover:underline">AdventureWorks labs</a>.
                </p>
            </div>
        </div>
    </section>

    <script is:inline>
        function syncWeb3FormsHcaptchaTheme() {
            const el = document.getElementById("hcaptcha-widget");
            if (!el) return;
            el.setAttribute(
                "data-theme",
                document.documentElement.classList.contains("dark")
                    ? "dark"
                    : "light",
            );
        }
        syncWeb3FormsHcaptchaTheme();
        new MutationObserver(syncWeb3FormsHcaptchaTheme).observe(
            document.documentElement,
            { attributes: true, attributeFilter: ["class"] },
        );
    </script>
    <script
        src="https://web3forms.com/client/script.js"
        async
        defer></script>

    <script define:vars={{ web3formsAccessKey }} is:inline>
        const form = document.getElementById("form");
        const submitBtn = form?.querySelector('button[type="submit"]');
        const toast = document.getElementById("feedback-toast");
        const toastIcon = document.getElementById("feedback-toast-icon");
        const toastTitle = document.getElementById("feedback-toast-title");
        const toastBody = document.getElementById("feedback-toast-body");
        const toastDismiss = document.getElementById("feedback-toast-dismiss");

        if (
            !form ||
            !(submitBtn instanceof HTMLButtonElement) ||
            !toast ||
            !toastIcon ||
            !toastTitle ||
            !toastBody ||
            !toastDismiss
        )
            return;

        let toastTimer = null;

        const successSvg =
            '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-querial-sky" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>';
        const errorSvg =
            '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-destructive" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>';

        function hideToast() {
            if (toastTimer) {
                clearTimeout(toastTimer);
                toastTimer = null;
            }
            toast.classList.remove("is-open", "is-success", "is-error");
            toast.setAttribute("role", "status");
            toast.removeAttribute("aria-labelledby");
        }

        function showToast(kind, title, body, autoHideMs) {
            hideToast();
            toastTitle.textContent = title;
            toastBody.textContent = body;
            toast.classList.remove("is-success", "is-error");
            toast.classList.add("is-open", kind === "success" ? "is-success" : "is-error");
            toast.setAttribute("role", kind === "error" ? "alert" : "status");

            toastIcon.className =
                "shrink-0 mt-0.5 w-9 h-9 rounded-lg flex items-center justify-center " +
                (kind === "success"
                    ? "bg-querial-sky/15 text-querial-sky"
                    : "bg-destructive/10 text-destructive");
            toastIcon.innerHTML = kind === "success" ? successSvg : errorSvg;

            if (autoHideMs > 0) {
                toastTimer = window.setTimeout(hideToast, autoHideMs);
            }
        }

        toastDismiss.addEventListener("click", hideToast);

        function resetHcaptchaInForm(formEl) {
            const hc = window.hcaptcha;
            if (!hc || typeof hc.reset !== "function") return false;

            const roots = new Set([formEl]);
            const mount = document.getElementById("hcaptcha-widget");
            if (mount) roots.add(mount);

            const ids = [];
            const seen = new Set();
            roots.forEach(function (root) {
                const nodes = root.querySelectorAll("[data-hcaptcha-widget-id]");
                for (let i = 0; i < nodes.length; i++) {
                    const raw = nodes[i].getAttribute("data-hcaptcha-widget-id");
                    if (raw == null || raw === "" || seen.has(raw)) continue;
                    seen.add(raw);
                    ids.push(raw);
                }
            });

            for (let j = 0; j < ids.length; j++) {
                const raw = ids[j];
                const asNum = Number(raw);
                const variants =
                    Number.isFinite(asNum) && String(asNum) === String(raw).trim()
                        ? [asNum, raw]
                        : [raw, asNum];
                for (let k = 0; k < variants.length; k++) {
                    try {
                        hc.reset(variants[k]);
                        return true;
                    } catch {
                        /* try next variant */
                    }
                }
            }

            try {
                hc.reset(0);
                return true;
            } catch {
                /* ignore */
            }
            return false;
        }

        function scheduleHcaptchaReset(formEl) {
            const run = function () {
                resetHcaptchaInForm(formEl);
            };
            run();
            queueMicrotask(run);
            window.setTimeout(run, 50);
            window.setTimeout(run, 200);
            window.setTimeout(run, 500);
            window.setTimeout(run, 1200);
        }

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            hideToast();

            const hCaptchaField = form.querySelector(
                'textarea[name="h-captcha-response"]',
            );
            if (!hCaptchaField || !hCaptchaField.value.trim()) {
                showToast(
                    "error",
                    "Verification required",
                    "Please complete the captcha before sending your message.",
                    0,
                );
                return;
            }

            const formData = new FormData(form);
            formData.append("access_key", web3formsAccessKey);

            const originalHtml = submitBtn.innerHTML;

            submitBtn.textContent = "Sending…";
            submitBtn.disabled = true;

            try {
                const response = await fetch("https://api.web3forms.com/submit", {
                    method: "POST",
                    body: formData,
                });

                const data = await response.json();

                if (response.ok) {
                    form.reset();
                    scheduleHcaptchaReset(form);
                    showToast(
                        "success",
                        "Message sent",
                        "Thanks for reaching out. We will get back to you soon.",
                        7000,
                    );
                } else {
                    showToast(
                        "error",
                        "Could not send",
                        typeof data.message === "string" && data.message
                            ? data.message
                            : "Please try again in a moment.",
                        0,
                    );
                }
            } catch (error) {
                showToast(
                    "error",
                    "Something went wrong",
                    "Check your connection and try again.",
                    0,
                );
            } finally {
                submitBtn.innerHTML = originalHtml;
                submitBtn.disabled = false;
            }
        });
    </script>
</Layout>
